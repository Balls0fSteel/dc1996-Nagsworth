{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nagsworth",
  "mainBinaryName": "nagsworth",
  "version": "0.1.0",
  "identifier": "org.nagsworth.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run ui:dev", "cwd": ".." },
    "beforeBuildCommand": { "script": "npm run ui:build", "cwd": ".." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nagsworth",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Activity tracker and break nagger",
    "category": "Productivity"
  }
}
