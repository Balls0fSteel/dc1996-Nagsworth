{
  "manifest_version": 3,
  "name": "activity_nagger",
  "description": "Reports the active tab to the activity_nagger desktop app on this computer. Nothing leaves your machine.",
  "version": "0.1.0",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_title": "activity_nagger", "default_popup": "options.html" }
}
